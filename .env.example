# 🗄️ Supabase (única fuente de verdad: catálogo, listas e historial)
# Obtené estos valores en: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# 🔐 Upstash Redis (Rate Limiting)
# Crea tu database en: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AYkgASQxxx...

# ⚡ Rate Limits Configurables (Opcional - valores por defecto mostrados)
# Ajusta estos valores para cambiar límites sin modificar código
RATE_LIMIT_API=30        # Requests por minuto - API general
RATE_LIMIT_SEARCH=20     # Requests por minuto - Búsqueda de productos
RATE_LIMIT_CREATE=15     # Requests por minuto - Creación de productos
